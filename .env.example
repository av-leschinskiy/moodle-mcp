# Generated by scripts/env-docs.mjs from envSchema in src/config.ts —
# do not edit by hand, run `npm run docs:env`.
#
# Copy to .env and fill in the required variables.

# Moodle site address (wwwroot), e.g. `https://moodle.example.org`
MOODLE_URL=

# Where `moodle-mcp-login` saves the token (path is resolved via `homedir()`)
# MOODLE_TOKEN_FILE=~/.config/mcp-moodle/token.json

# Web service token override (CI / smoke tests)
# MOODLE_TOKEN=

# Timeout of a single API request (ms)
# MOODLE_TIMEOUT=30000

# Chrome/Chromium binary for `moodle-mcp-login` (looked up in PATH by default)
# MOODLE_CHROME=

# `1`/`true`/`yes`/`on` enables debug output to stderr and `debug` level in the host log channel
# MOODLE_DEBUG=false
