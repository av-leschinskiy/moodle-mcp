# Сгенерировано scripts/env-docs.mjs из envSchema в src/config.ts —
# руками не править, запусти `npm run docs:env`.
#
# Скопируй в .env и заполни обязательные переменные.

# Адрес сайта Moodle (wwwroot), например `https://moodle.example.org`
MOODLE_URL=

# Куда `moodle-mcp-login` сохраняет токен (путь резолвится через `homedir()`)
# MOODLE_TOKEN_FILE=~/.config/mcp-moodle/token.json

# Override токена веб-сервиса (CI / смок-тесты)
# MOODLE_TOKEN=

# Таймаут одного запроса к API (мс)
# MOODLE_TIMEOUT=30000

# Бинарь Chrome/Chromium для `moodle-mcp-login` (по умолчанию ищется в PATH)
# MOODLE_CHROME=

# `1`/`true`/`yes`/`on` — отладочный вывод в stderr и уровень `debug` в канал хоста
# MOODLE_DEBUG=false
